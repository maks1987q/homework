import time
import unittest

# Декоратор для вимірювання часу (з додаткового завдання)
def timer_decorator(func):
    def wrapper(*args, **kwargs):
        start = time.time()
        result = func(*args, **kwargs)
        end = time.time()
        work_time = end - start
        print(f"Функція виконалася за {work_time} секунд")
        return result
    return wrapper

# Функція для перевірки декоратора
@timer_decorator
def test_func():
    time.sleep(1)
    return "ok"

# Тести для перевірки
class TestTimer(unittest.TestCase):
    def test_work(self):
        res = test_func()
        self.assertEqual(res, "ok")

if __name__ == "__main__":
    unittest.main()
